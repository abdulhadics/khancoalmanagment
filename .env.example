# Local development defaults
DEPLOYMENT_ENV=development
APP_PORT=3000
# APP_ORIGIN=http://127.0.0.1:3000

# Set a PostgreSQL connection URL for local development.
# Deployment requires DEPLOYMENT_ENV=production, an HTTPS APP_ORIGIN,
# and the connection URL for the dedicated application database role.
# DATABASE_URL=

# Set a separate, schema-owner connection for migrations in production.
# MIGRATION_DATABASE_URL=

# The test harness requires a disposable localhost PostgreSQL cluster.
# Set TEST_ADMIN_DATABASE_URL in the test command's environment.

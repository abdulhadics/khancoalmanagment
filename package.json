{
  "name": "khancoalsupplier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/serve.ts dev",
    "start": "node --import tsx scripts/serve.ts start",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --import tsx scripts/test-database.ts",
    "test:integration:prepared": "vitest run --config vitest.integration.config.ts",
    "test:e2e:prepared": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed-owner": "node --import tsx scripts/seed-owner.ts",
    "postinstall": "npm run db:generate",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@fontsource-variable/inter": "5.3.0",
    "@next/env": "16.4.6",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pdfkit": "0.21.0",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.3.1",
    "tsx": "4.20.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  OWNER
  ACCOUNTANT
  OPERATOR
  VIEWER

  @@map("role_code")
}

enum LocaleCode {
  ENGLISH
  URDU
  PASHTO

  @@map("locale_code")
}

enum AuthChallengePurpose {
  PASSWORD_RESET
  PASSWORD_CHANGE
  TOTP_CHALLENGE
  TOTP_ENROLLMENT

  @@map("auth_challenge_purpose")
}

enum BankCategory {
  BANK
  CASH

  @@map("bank_category")
}

enum WeightUnit {
  TON
  TONNE
  MT

  @@map("weight_unit")
}

enum OrderStatus {
  PENDING_PRICING
  POSTED
  VOIDED

  @@map("order_status")
}

enum PaymentDirection {
  IN
  OUT

  @@map("payment_direction")
}

enum PaymentMethod {
  CHEQUE
  CASH
  BANK_TRANSFER
  ONLINE_IBFT
  PAY_ORDER
  ADJUSTMENT

  @@map("payment_method")
}

enum PaymentStatus {
  POSTED
  RECEIVED
  DEPOSITED
  CLEARED
  BOUNCED
  VOIDED

  @@map("payment_status")
}

enum LedgerEntryKind {
  ORDER_SALE
  ORDER_PURCHASE
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  CUSTOMER_OPENING
  SUPPLIER_OPENING
  CUSTOMER_ADJUSTMENT
  SUPPLIER_ADJUSTMENT

  @@map("ledger_entry_kind")
}

enum NumberSequenceKind {
  ORDER
  VOUCHER
  CUSTOMER
  SUPPLIER

  @@map("number_sequence_kind")
}

enum AuditActorType {
  USER
  ANONYMOUS
  SYSTEM

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED

  @@map("audit_outcome")
}

enum BackupSource {
  SCHEDULED
  MANUAL

  @@map("backup_source")
}

enum BackupState {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("backup_state")
}

enum NotificationType {
  CUSTOMER_OVERDUE
  SUPPLIER_OVERDUE
  DELIVERY_PENDING
  GENERAL

  @@map("notification_type")
}

enum ExpenseCategory {
  RENT
  TRANSPORTATION
  LABOR
  SALARY
  UTILITIES
  FOOD_REFRESHMENTS
  MAINTENANCE
  OTHER

  @@map("expense_category")
}

model Role {
  code  RoleCode @id
  users User[]

  @@map("roles")
}

model User {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username         String           @unique @db.VarChar(64)
  email            String           @unique @db.VarChar(254)
  displayName      String           @map("display_name") @db.VarChar(120)
  roleCode         RoleCode         @map("role_code")
  isActive         Boolean          @default(true) @map("is_active")
  locale           LocaleCode       @default(ENGLISH)
  lastLoginAt      DateTime?        @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  role             Role             @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  credential       UserCredential?
  sessions         Session[]
  challenges       AuthChallenge[]
  auditLogs        AuditLog[]
  operations       IdempotencyKey[]
  customersCreated Customer[]       @relation("CustomerCreated")
  customersUpdated Customer[]       @relation("CustomerUpdated")
  suppliersCreated Supplier[]       @relation("SupplierCreated")
  suppliersUpdated Supplier[]       @relation("SupplierUpdated")
  ordersCreated    Order[]          @relation("OrderCreated")
  ordersUpdated    Order[]          @relation("OrderUpdated")
  ordersDeleted    Order[]          @relation("OrderDeleted")
  orderRevisions   OrderRevision[]
  paymentsCreated  Payment[]        @relation("PaymentCreated")
  paymentsVoided   Payment[]        @relation("PaymentVoided")
  chequeEvents     ChequeEvent[]
  ledgerEntries    LedgerEntry[]
  periodLocks      PeriodLock[]
  backups          Backup[]
  expensesCreated  Expense[]        @relation("ExpenseCreated")
  expensesVoided   Expense[]        @relation("ExpenseVoided")
  deliveriesCreated DeliveryRecord[] @relation("DeliveryCreated")
  pickupsCreated   DeliveryPickup[] @relation("PickupCreated")

  @@index([roleCode, isActive])
  @@map("users")
}

model UserCredential {
  userId              String   @id @map("user_id") @db.Uuid
  passwordHash        String   @map("password_hash")
  mustChangePassword  Boolean  @default(true) @map("must_change_password")
  totpSecretEncrypted Bytes?   @map("totp_secret_encrypted")
  totpKeyId           String?  @map("totp_key_id") @db.VarChar(100)
  lastTotpStep        BigInt?  @map("last_totp_step")
  recoveryCodeDigests String[] @default([]) @map("recovery_code_digests")
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(128)
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthChallenge {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  purpose     AuthChallengePurpose
  tokenDigest String               @unique @map("token_digest") @db.VarChar(128)
  attempts    Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?            @map("consumed_at") @db.Timestamptz(3)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model RateLimitBucket {
  scope            String   @db.VarChar(80)
  identifierDigest String   @map("identifier_digest") @db.VarChar(128)
  windowStart      DateTime @map("window_start") @db.Timestamptz(3)
  attemptCount     Int      @default(0) @map("attempt_count")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([scope, identifierDigest, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model CompanySettings {
  id                Int             @id @default(1) @db.SmallInt
  documentProfileId String          @map("document_profile_id") @db.Uuid
  orderPrefix       String          @default("ORD") @map("order_prefix") @db.VarChar(16)
  voucherPrefix     String          @default("VCH") @map("voucher_prefix") @db.VarChar(16)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  documentProfile   DocumentProfile @relation(fields: [documentProfileId], references: [id], onDelete: Restrict)

  @@map("company_settings")
}

model DocumentProfile {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String            @db.VarChar(160)
  tagline        String?           @db.VarChar(250)
  address        String?           @db.VarChar(500)
  phone          String?           @db.VarChar(40)
  email          String?           @db.VarChar(254)
  logoBytes      Bytes?            @map("logo_bytes")
  logoMediaType  String?           @map("logo_media_type") @db.VarChar(32)
  currencySymbol String            @default("Rs.") @map("currency_symbol") @db.VarChar(12)
  weightUnit     WeightUnit        @default(TON) @map("weight_unit")
  dateFormat     String            @default("dd MMM yyyy") @map("date_format") @db.VarChar(32)
  numberFormat   String            @default("en-PK") @map("number_format") @db.VarChar(32)
  footer         String?           @db.VarChar(500)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  settings       CompanySettings[]
  orderRevisions OrderRevision[]
  payments       Payment[]

  @@map("document_profiles")
}

model Bank {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(80)
  nameKey   String       @unique @map("name_key") @db.VarChar(80)
  category  BankCategory
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  payments  Payment[]

  @@index([isActive, nameKey, id])
  @@map("banks")
}

model Customer {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String          @unique @db.VarChar(32)
  name          String          @db.VarChar(160)
  nameKey       String          @map("name_key") @db.VarChar(160)
  industry      String?         @db.VarChar(120)
  contactPerson String?         @map("contact_person") @db.VarChar(120)
  phone         String?         @db.VarChar(40)
  email         String?         @db.VarChar(254)
  city          String?         @db.VarChar(120)
  address       String?         @db.VarChar(500)
  notes         String?         @db.VarChar(1500)
  isActive      Boolean         @default(true) @map("is_active")
  creditLimit   Decimal?        @map("credit_limit") @db.Decimal(14, 2)
  createdById   String          @map("created_by_id") @db.Uuid
  updatedById   String          @map("updated_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     User            @relation("CustomerCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User            @relation("CustomerUpdated", fields: [updatedById], references: [id], onDelete: Restrict)
  orders        Order[]
  revisions     OrderRevision[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  notifications Notification[]
  deliveries    DeliveryRecord[]

  @@index([isActive, nameKey, id])
  @@index([nameKey, id])
  @@map("customers")
}

model Supplier {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String          @unique @db.VarChar(32)
  name          String          @db.VarChar(160)
  nameKey       String          @map("name_key") @db.VarChar(160)
  contactPerson String?         @map("contact_person") @db.VarChar(120)
  phone         String?         @db.VarChar(40)
  email         String?         @db.VarChar(254)
  city          String?         @db.VarChar(120)
  region        String?         @db.VarChar(120)
  address       String?         @db.VarChar(500)
  notes         String?         @db.VarChar(1500)
  isActive      Boolean         @default(true) @map("is_active")
  createdById   String          @map("created_by_id") @db.Uuid
  updatedById   String          @map("updated_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     User            @relation("SupplierCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User            @relation("SupplierUpdated", fields: [updatedById], references: [id], onDelete: Restrict)
  mines         Mine[]
  orders        Order[]
  revisions     OrderRevision[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  notifications Notification[]

  @@index([isActive, nameKey, id])
  @@index([nameKey, id])
  @@map("suppliers")
}

model Mine {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String          @map("supplier_id") @db.Uuid
  code       String          @db.VarChar(60)
  codeKey    String          @map("code_key") @db.VarChar(60)
  name       String          @db.VarChar(160)
  isActive   Boolean         @default(true) @map("is_active")
  isDefault  Boolean         @default(false) @map("is_default")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orders     Order[]
  revisions  OrderRevision[]

  @@unique([supplierId, id])
  @@unique([supplierId, codeKey])
  @@index([supplierId, isActive, codeKey])
  @@map("mines")
}

model Order {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo           String          @unique @map("order_no") @db.VarChar(48)
  numberYear        Int             @map("number_year") @db.SmallInt
  ordinal           BigInt
  status            OrderStatus     @default(PENDING_PRICING)
  currentRevisionNo Int?            @map("current_revision_no")
  businessDate      DateTime        @map("business_date") @db.Date
  customerId        String          @map("customer_id") @db.Uuid
  supplierId        String          @map("supplier_id") @db.Uuid
  mineId            String          @map("mine_id") @db.Uuid
  vehicleNo         String          @map("vehicle_no") @db.VarChar(40)
  biltyNo           String?         @map("bilty_no") @db.VarChar(80)
  createdById       String          @map("created_by_id") @db.Uuid
  updatedById       String          @map("updated_by_id") @db.Uuid
  deletedById       String?         @map("deleted_by_id") @db.Uuid
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  deleteReason      String?         @map("delete_reason") @db.VarChar(500)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  mine              Mine            @relation(fields: [supplierId, mineId], references: [supplierId, id], onDelete: Restrict)
  createdBy         User            @relation("OrderCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User            @relation("OrderUpdated", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy         User?           @relation("OrderDeleted", fields: [deletedById], references: [id], onDelete: Restrict)
  currentRevision   OrderRevision?  @relation("CurrentOrderRevision", fields: [id, currentRevisionNo], references: [orderId, revisionNo], onDelete: Restrict)
  revisions         OrderRevision[] @relation("OrderRevisions")

  @@unique([numberYear, ordinal])
  @@index([status, businessDate, id])
  @@index([businessDate, id])
  @@index([customerId, businessDate, id])
  @@index([supplierId, businessDate, id])
  @@index([mineId, businessDate, id])
  @@index([vehicleNo, businessDate])
  @@index([createdById, businessDate, id])
  @@map("orders")
}

model OrderRevision {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  revisionNo        Int             @map("revision_no")
  businessDate      DateTime        @map("business_date") @db.Date
  customerId        String          @map("customer_id") @db.Uuid
  supplierId        String          @map("supplier_id") @db.Uuid
  mineId            String          @map("mine_id") @db.Uuid
  vehicleNo         String          @map("vehicle_no") @db.VarChar(40)
  biltyNo           String?         @map("bilty_no") @db.VarChar(80)
  notes             String?         @db.VarChar(1500)
  weight            Decimal         @db.Decimal(12, 3)
  purchaseRate      Decimal?        @map("purchase_rate") @db.Decimal(12, 2)
  sellRate          Decimal?        @map("sell_rate") @db.Decimal(12, 2)
  buyAmount         Decimal?        @map("buy_amount") @db.Decimal(14, 2)
  sellAmount        Decimal?        @map("sell_amount") @db.Decimal(14, 2)
  profit            Decimal?        @db.Decimal(14, 2)
  documentProfileId String          @map("document_profile_id") @db.Uuid
  actorId           String          @map("actor_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  order             Order           @relation("OrderRevisions", fields: [orderId], references: [id], onDelete: Restrict)
  currentFor        Order[]         @relation("CurrentOrderRevision")
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  mine              Mine            @relation(fields: [supplierId, mineId], references: [supplierId, id], onDelete: Restrict)
  documentProfile   DocumentProfile @relation(fields: [documentProfileId], references: [id], onDelete: Restrict)
  actor             User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  ledgerEntries     LedgerEntry[]

  @@unique([orderId, revisionNo])
  @@index([businessDate, id])
  @@index([customerId, businessDate, id])
  @@index([supplierId, businessDate, id])
  @@index([mineId, businessDate, id])
  @@map("order_revisions")
}

model Payment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherNo         String           @unique @map("voucher_no") @db.VarChar(48)
  ordinal           BigInt           @unique
  businessDate      DateTime         @map("business_date") @db.Date
  customerId        String?          @map("customer_id") @db.Uuid
  supplierId        String?          @map("supplier_id") @db.Uuid
  direction         PaymentDirection
  method            PaymentMethod
  bankId            String?          @map("bank_id") @db.Uuid
  bankName          String?          @map("bank_name") @db.VarChar(80)
  referenceNo       String?          @map("reference_no") @db.VarChar(100)
  amount            Decimal          @db.Decimal(14, 2)
  notes             String?          @db.VarChar(1500)
  documentProfileId String           @map("document_profile_id") @db.Uuid
  createdById       String           @map("created_by_id") @db.Uuid
  status            PaymentStatus
  voidedById        String?          @map("voided_by_id") @db.Uuid
  voidedAt          DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidReason        String?          @map("void_reason") @db.VarChar(500)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  bank              Bank?            @relation(fields: [bankId], references: [id], onDelete: Restrict)
  documentProfile   DocumentProfile  @relation(fields: [documentProfileId], references: [id], onDelete: Restrict)
  createdBy         User             @relation("PaymentCreated", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy          User?            @relation("PaymentVoided", fields: [voidedById], references: [id], onDelete: Restrict)
  chequeEvents      ChequeEvent[]
  ledgerEntries     LedgerEntry[]

  @@index([direction, businessDate, id])
  @@index([customerId, businessDate, id])
  @@index([supplierId, businessDate, id])
  @@index([status, businessDate, id])
  @@index([businessDate, id])
  @@map("payments")
}

model ChequeEvent {
  id           BigInt        @id @default(autoincrement())
  paymentId    String        @map("payment_id") @db.Uuid
  previous     PaymentStatus
  resulting    PaymentStatus
  businessDate DateTime      @map("business_date") @db.Date
  actorId      String        @map("actor_id") @db.Uuid
  reason       String?       @db.VarChar(500)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor        User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([paymentId, id])
  @@map("cheque_events")
}

model LedgerEntry {
  id              BigInt          @id @default(autoincrement())
  kind            LedgerEntryKind
  businessDate    DateTime        @map("business_date") @db.Date
  customerId      String?         @map("customer_id") @db.Uuid
  supplierId      String?         @map("supplier_id") @db.Uuid
  orderRevisionId String?         @map("order_revision_id") @db.Uuid
  paymentId       String?         @map("payment_id") @db.Uuid
  amount          Decimal         @db.Decimal(14, 2)
  reversesId      BigInt?         @unique @map("reverses_id")
  actorId         String          @map("actor_id") @db.Uuid
  reason          String?         @db.VarChar(500)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderRevision   OrderRevision?  @relation(fields: [orderRevisionId], references: [id], onDelete: Restrict)
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reverses        LedgerEntry?    @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal        LedgerEntry?    @relation("LedgerReversal")
  actor           User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([customerId, businessDate, id])
  @@index([supplierId, businessDate, id])
  @@index([businessDate, kind, id])
  @@index([orderRevisionId])
  @@index([paymentId])
  @@map("ledger_entries")
}

model NumberSequence {
  kind        NumberSequenceKind
  scope       Int
  nextOrdinal BigInt             @default(1) @map("next_ordinal")

  @@id([kind, scope])
  @@map("number_sequences")
}

model PeriodLock {
  month         DateTime @id @db.Date
  isMonthLocked Boolean  @default(false) @map("is_month_locked")
  isYearLocked  Boolean  @default(false) @map("is_year_locked")
  updatedById   String?  @map("updated_by_id") @db.Uuid
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("period_locks")
}

model IdempotencyKey {
  actorId       String   @map("actor_id") @db.Uuid
  operation     String   @db.VarChar(80)
  key           String   @db.VarChar(100)
  requestDigest String   @map("request_digest") @db.VarChar(128)
  response      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@id([actorId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         BigInt         @id @default(autoincrement())
  actorId    String?        @map("actor_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  area       String         @db.VarChar(80)
  action     String         @db.VarChar(120)
  targetType String         @map("target_type") @db.VarChar(80)
  targetId   String?        @map("target_id") @db.VarChar(160)
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  requestId  String         @map("request_id") @db.VarChar(128)
  ipAddress  String?        @map("ip_address") @db.Inet
  outcome    AuditOutcome
  before     Json?
  after      Json?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([occurredAt, id])
  @@index([actorId, occurredAt, id])
  @@index([action, occurredAt, id])
  @@index([targetType, targetId, occurredAt, id])
  @@map("audit_logs")
}

model Backup {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      BackupSource
  actorId     String?      @map("actor_id") @db.Uuid
  state       BackupState  @default(RUNNING)
  startedAt   DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  byteCount   BigInt?      @map("byte_count")
  archiveHash String?      @map("archive_hash") @db.VarChar(128)
  archiveId   String?      @unique @map("archive_id") @db.VarChar(120)
  failureCode String?      @map("failure_code") @db.VarChar(80)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([state, completedAt, id])
  @@map("backups")
}

model Notification {
  id          BigInt           @id @default(autoincrement())
  type        NotificationType
  title       String           @db.VarChar(250)
  message     String           @db.VarChar(1500)
  customerId  String?          @map("customer_id") @db.Uuid
  supplierId  String?          @map("supplier_id") @db.Uuid
  isRead      Boolean          @default(false) @map("is_read")
  isDismissed Boolean          @default(false) @map("is_dismissed")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([isRead, isDismissed, createdAt])
  @@index([customerId])
  @@index([supplierId])
  @@map("notifications")
}

model Expense {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessDate DateTime        @map("business_date") @db.Date
  category     ExpenseCategory
  description  String          @db.VarChar(500)
  amount       Decimal         @db.Decimal(14, 2)
  notes        String?         @db.VarChar(1500)
  createdById  String          @map("created_by_id") @db.Uuid
  voidedById   String?         @map("voided_by_id") @db.Uuid
  voidedAt     DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidReason   String?         @map("void_reason") @db.VarChar(500)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    User            @relation("ExpenseCreated", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy     User?           @relation("ExpenseVoided", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([businessDate, id])
  @@index([category, businessDate])
  @@map("expenses")
}

model DeliveryRecord {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String           @map("customer_id") @db.Uuid
  businessDate    DateTime         @map("business_date") @db.Date
  orderedWeight   Decimal          @map("ordered_weight") @db.Decimal(12, 3)
  deliveredWeight Decimal          @default(0) @map("delivered_weight") @db.Decimal(12, 3)
  notes           String?          @db.VarChar(1500)
  isComplete      Boolean          @default(false) @map("is_complete")
  createdById     String           @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("DeliveryCreated", fields: [createdById], references: [id], onDelete: Restrict)
  pickups         DeliveryPickup[]

  @@index([customerId, isComplete])
  @@index([businessDate])
  @@map("delivery_records")
}

model DeliveryPickup {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryRecordId String         @map("delivery_record_id") @db.Uuid
  businessDate     DateTime       @map("business_date") @db.Date
  weight           Decimal        @db.Decimal(12, 3)
  vehicleNo        String?        @map("vehicle_no") @db.VarChar(40)
  notes            String?        @db.VarChar(1500)
  createdById      String         @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveryRecord   DeliveryRecord @relation(fields: [deliveryRecordId], references: [id], onDelete: Restrict)
  createdBy        User           @relation("PickupCreated", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([deliveryRecordId])
  @@map("delivery_pickups")
}


generator client {
  provider = "prisma-client"
  output   = "../../src/generated/sqlite"
}

datasource db {
  provider = "sqlite"
}

enum RoleCode {
  OWNER
  ACCOUNTANT
  OPERATOR
  VIEWER

  @@map("role_code")
}

enum LocaleCode {
  ENGLISH
  URDU
  PASHTO

  @@map("locale_code")
}

enum AuthChallengePurpose {
  PASSWORD_RESET
  PASSWORD_CHANGE
  TOTP_CHALLENGE
  TOTP_ENROLLMENT

  @@map("auth_challenge_purpose")
}

enum BankCategory {
  BANK
  CASH

  @@map("bank_category")
}

enum WeightUnit {
  TON
  TONNE
  MT

  @@map("weight_unit")
}

enum OrderStatus {
  PENDING_PRICING
  POSTED
  VOIDED

  @@map("order_status")
}

enum PaymentDirection {
  IN
  OUT

  @@map("payment_direction")
}

enum PaymentMethod {
  CHEQUE
  CASH
  BANK_TRANSFER
  ONLINE_IBFT
  PAY_ORDER
  ADJUSTMENT

  @@map("payment_method")
}

enum PaymentStatus {
  POSTED
  RECEIVED
  DEPOSITED
  CLEARED
  BOUNCED
  VOIDED

  @@map("payment_status")
}

enum LedgerEntryKind {
  ORDER_SALE
  ORDER_PURCHASE
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  CUSTOMER_OPENING
  SUPPLIER_OPENING
  CUSTOMER_ADJUSTMENT
  SUPPLIER_ADJUSTMENT

  @@map("ledger_entry_kind")
}

enum NumberSequenceKind {
  ORDER
  VOUCHER
  CUSTOMER
  SUPPLIER

  @@map("number_sequence_kind")
}

enum AuditActorType {
  USER
  ANONYMOUS
  SYSTEM

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED

  @@map("audit_outcome")
}

enum BackupSource {
  SCHEDULED
  MANUAL

  @@map("backup_source")
}

enum BackupState {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("backup_state")
}

model Role {
  code  RoleCode @id
  users User[]

  @@map("roles")
}

model User {
  id               String           @id @default(uuid())
  username         String           @unique
  email            String           @unique
  displayName      String           @map("display_name")
  roleCode         RoleCode         @map("role_code")
  isActive         Boolean          @default(true) @map("is_active")
  locale           LocaleCode       @default(ENGLISH)
  lastLoginAt      DateTime?        @map("last_login_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  role             Role             @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  credential       UserCredential?
  sessions         Session[]
  challenges       AuthChallenge[]
  auditLogs        AuditLog[]
  operations       IdempotencyKey[]
  customersCreated Customer[]       @relation("CustomerCreated")
  customersUpdated Customer[]       @relation("CustomerUpdated")
  suppliersCreated Supplier[]       @relation("SupplierCreated")
  suppliersUpdated Supplier[]       @relation("SupplierUpdated")
  ordersCreated    Order[]          @relation("OrderCreated")
  ordersUpdated    Order[]          @relation("OrderUpdated")
  ordersDeleted    Order[]          @relation("OrderDeleted")
  orderRevisions   OrderRevision[]
  paymentsCreated  Payment[]        @relation("PaymentCreated")
  paymentsVoided   Payment[]        @relation("PaymentVoided")
  chequeEvents     ChequeEvent[]
  ledgerEntries    LedgerEntry[]
  periodLocks      PeriodLock[]
  backups          Backup[]

  @@index([roleCode, isActive])
  @@map("users")
}

model UserCredential {
  userId              String  @id @map("user_id")
  passwordHash        String  @map("password_hash")
  mustChangePassword  Boolean @default(true) @map("must_change_password")
  totpSecretEncrypted Bytes?  @map("totp_secret_encrypted")
  totpKeyId           String? @map("totp_key_id")
  lastTotpStep        BigInt? @map("last_totp_step")
  recoveryCodeDigests Json    @default("[]") @map("recovery_code_digests")
  user                User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

model Session {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tokenDigest String    @unique @map("token_digest")
  issuedAt    DateTime  @default(now()) @map("issued_at")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthChallenge {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  purpose     AuthChallengePurpose
  tokenDigest String               @unique @map("token_digest")
  attempts    Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at")
  expiresAt   DateTime             @map("expires_at")
  consumedAt  DateTime?            @map("consumed_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model RateLimitBucket {
  scope            String
  identifierDigest String   @map("identifier_digest")
  windowStart      DateTime @map("window_start")
  attemptCount     Int      @default(0) @map("attempt_count")
  expiresAt        DateTime @map("expires_at")

  @@id([scope, identifierDigest, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model CompanySettings {
  id                Int             @id @default(1)
  documentProfileId String          @map("document_profile_id")
  orderPrefix       String          @default("ORD") @map("order_prefix")
  voucherPrefix     String          @default("VCH") @map("voucher_prefix")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")
  documentProfile   DocumentProfile @relation(fields: [documentProfileId], references: [id], onDelete: Restrict)

  @@map("company_settings")
}

model DocumentProfile {
  id             String            @id @default(uuid())
  name           String
  tagline        String?
  address        String?
  phone          String?
  email          String?
  logoBytes      Bytes?            @map("logo_bytes")
  logoMediaType  String?           @map("logo_media_type")
  currencySymbol String            @default("Rs.") @map("currency_symbol")
  weightUnit     WeightUnit        @default(TON) @map("weight_unit")
  dateFormat     String            @default("dd MMM yyyy") @map("date_format")
  numberFormat   String            @default("en-PK") @map("number_format")
  footer         String?
  createdAt      DateTime          @default(now()) @map("created_at")
  settings       CompanySettings[]
  orderRevisions OrderRevision[]
  payments       Payment[]

  @@map("document_profiles")
}

model Bank {
  id        String       @id @default(uuid())
  name      String
  nameKey   String       @unique @map("name_key")
  category  BankCategory
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")
  payments  Payment[]

  @@index([isActive, nameKey, id])
  @@map("banks")
}

model Customer {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  nameKey       String          @map("name_key")
  industry      String?
  contactPerson String?         @map("contact_person")
  phone         String?
  email         String?
  city          String?
  address       String?
  notes         String?
  isActive      Boolean         @default(true) @map("is_active")
  creditLimit   BigInt?         @map("credit_limit")
  createdById   String          @map("created_by_id")
  updatedById   String          @map("updated_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")
  createdBy     User            @relation("CustomerCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User            @relation("CustomerUpdated", fields: [updatedById], references: [id], onDelete: Restrict)
  orders        Order[]
  revisions     OrderRevision[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@index([isActive, nameKey, id])
  @@index([nameKey, id])
  @@map("customers")
}

model Supplier {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  nameKey       String          @map("name_key")
  contactPerson String?         @map("contact_person")
  phone         String?
  email         String?
  city          String?
  region        String?
  address       String?
  notes         String?
  isActive      Boolean         @default(true) @map("is_active")
  createdById   String          @map("created_by_id")
  updatedById   String          @map("updated_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")
  createdBy     User            @relation("SupplierCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User            @relation("SupplierUpdated", fields: [updatedById], references: [id], onDelete: Restrict)
  mines         Mine[]
  orders        Order[]
  revisions     OrderRevision[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@index([isActive, nameKey, id])
  @@index([nameKey, id])
  @@map("suppliers")
}

model Mine {
  id         String          @id @default(uuid())
  supplierId String          @map("supplier_id")
  code       String
  codeKey    String          @map("code_key")
  name       String
  isActive   Boolean         @default(true) @map("is_active")
  isDefault  Boolean         @default(false) @map("is_default")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at")
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orders     Order[]
  revisions  OrderRevision[]

  @@unique([supplierId, id])
  @@unique([supplierId, codeKey])
  @@index([supplierId, isActive, codeKey])
  @@map("mines")
}

model Order {
  id                String          @id @default(uuid())
  orderNo           String          @unique @map("order_no")
  numberYear        Int             @map("number_year")
  ordinal           BigInt
  status            OrderStatus     @default(PENDING_PRICING)
  currentRevisionNo Int?            @map("current_revision_no")
  businessDate      String          @map("business_date")
  customerId        String          @map("customer_id")
  supplierId        String          @map("supplier_id")
  mineId            String          @map("mine_id")
  vehicleNo         String          @map("vehicle_no")
  biltyNo           String?         @map("bilty_no")
  createdById       String          @map("created_by_id")
  updatedById       String          @map("updated_by_id")
  deletedById       String?         @map("deleted_by_id")
  deletedAt         DateTime?       @map("deleted_at")
  deleteReason      String?         @map("delete_reason")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  mine              Mine            @relation(fields: [supplierId, mineId], references: [supplierId, id], onDelete: Restrict)
  createdBy         User            @relation("OrderCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User            @relation("OrderUpdated", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy         User?           @relation("OrderDeleted", fields: [deletedById], references: [id], onDelete: Restrict)
  currentRevision   OrderRevision?  @relation("CurrentOrderRevision", fields: [id, currentRevisionNo], references: [orderId, revisionNo], onDelete: Restrict)
  revisions         OrderRevision[] @relation("OrderRevisions")

  @@unique([numberYear, ordinal])
  @@index([status, businessDate, id])
  @@index([businessDate, id])
  @@index([customerId, businessDate, id])
  @@index([supplierId, businessDate, id])
  @@index([mineId, businessDate, id])
  @@index([vehicleNo, businessDate])
  @@index([createdById, businessDate, id])
  @@map("orders")
}

model OrderRevision {
  id                String          @id @default(uuid())
  orderId           String          @map("order_id")
  revisionNo        Int             @map("revision_no")
  businessDate      String          @map("business_date")
  customerId        String          @map("customer_id")
  supplierId        String          @map("supplier_id")
  mineId            String          @map("mine_id")
  vehicleNo         String          @map("vehicle_no")
  biltyNo           String?         @map("bilty_no")
  notes             String?
  weight            BigInt
  purchaseRate      BigInt?         @map("purchase_rate")
  sellRate          BigInt?         @map("sell_rate")
  buyAmount         BigInt?         @map("buy_amount")
  sellAmount        BigInt?         @map("sell_amount")
  profit            BigInt?
  documentProfileId String          @map("document_profile_id")
  actorId           String          @map("actor_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  order             Order           @relation("OrderRevisions", fields: [orderId], references: [id], onDelete: Restrict)
  currentFor        Order[]         @relation("CurrentOrderRevision")
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  mine              Mine            @relation(fields: [supplierId, mineId], references: [supplierId, id], onDelete: Restrict)
  documentProfile   DocumentProfile @relation(fields: [documentProfileId], references: [id], onDelete: Restrict)
  actor             User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  ledgerEntries     LedgerEntry[]

  @@unique([orderId, revisionNo])
  @@index([businessDate, id])
  @@index([customerId, businessDate, id])
  @@index([supplierId, businessDate, id])
  @@index([mineId, businessDate, id])
  @@map("order_revisions")
}

model Payment {
  id                String           @id @default(uuid())
  voucherNo         String           @unique @map("voucher_no")
  ordinal           BigInt           @unique
  businessDate      String           @map("business_date")
  customerId        String?          @map("customer_id")
  supplierId        String?          @map("supplier_id")
  direction         PaymentDirection
  method            PaymentMethod
  bankId            String?          @map("bank_id")
  bankName          String?          @map("bank_name")
  referenceNo       String?          @map("reference_no")
  amount            BigInt
  notes             String?
  documentProfileId String           @map("document_profile_id")
  createdById       String           @map("created_by_id")
  status            PaymentStatus
  voidedById        String?          @map("voided_by_id")
  voidedAt          DateTime?        @map("voided_at")
  voidReason        String?          @map("void_reason")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at")
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  bank              Bank?            @relation(fields: [bankId], references: [id], onDelete: Restrict)
  documentProfile   DocumentProfile  @relation(fields: [documentProfileId], references: [id], onDelete: Restrict)
  createdBy         User             @relation("PaymentCreated", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy          User?            @relation("PaymentVoided", fields: [voidedById], references: [id], onDelete: Restrict)
  chequeEvents      ChequeEvent[]
  ledgerEntries     LedgerEntry[]

  @@index([direction, businessDate, id])
  @@index([customerId, businessDate, id])
  @@index([supplierId, businessDate, id])
  @@index([status, businessDate, id])
  @@index([businessDate, id])
  @@map("payments")
}

model ChequeEvent {
  id           BigInt        @id @default(autoincrement())
  paymentId    String        @map("payment_id")
  previous     PaymentStatus
  resulting    PaymentStatus
  businessDate String        @map("business_date")
  actorId      String        @map("actor_id")
  reason       String?
  createdAt    DateTime      @default(now()) @map("created_at")
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor        User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([paymentId, id])
  @@map("cheque_events")
}

model LedgerEntry {
  id              BigInt          @id @default(autoincrement())
  kind            LedgerEntryKind
  businessDate    String          @map("business_date")
  customerId      String?         @map("customer_id")
  supplierId      String?         @map("supplier_id")
  orderRevisionId String?         @map("order_revision_id")
  paymentId       String?         @map("payment_id")
  amount          BigInt
  reversesId      BigInt?         @unique @map("reverses_id")
  actorId         String          @map("actor_id")
  reason          String?
  createdAt       DateTime        @default(now()) @map("created_at")
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderRevision   OrderRevision?  @relation(fields: [orderRevisionId], references: [id], onDelete: Restrict)
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reverses        LedgerEntry?    @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal        LedgerEntry?    @relation("LedgerReversal")
  actor           User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([customerId, businessDate, id])
  @@index([supplierId, businessDate, id])
  @@index([businessDate, kind, id])
  @@index([orderRevisionId])
  @@index([paymentId])
  @@map("ledger_entries")
}

model NumberSequence {
  kind        NumberSequenceKind
  scope       Int
  nextOrdinal BigInt             @default(1) @map("next_ordinal")

  @@id([kind, scope])
  @@map("number_sequences")
}

model PeriodLock {
  month         String   @id
  isMonthLocked Boolean  @default(false) @map("is_month_locked")
  isYearLocked  Boolean  @default(false) @map("is_year_locked")
  updatedById   String?  @map("updated_by_id")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy     User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("period_locks")
}

model IdempotencyKey {
  actorId       String   @map("actor_id")
  operation     String
  key           String
  requestDigest String   @map("request_digest")
  response      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@id([actorId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         BigInt         @id @default(autoincrement())
  actorId    String?        @map("actor_id")
  actorType  AuditActorType @map("actor_type")
  area       String
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id")
  occurredAt DateTime       @default(now()) @map("occurred_at")
  requestId  String         @map("request_id")
  ipAddress  String?        @map("ip_address")
  outcome    AuditOutcome
  before     Json?
  after      Json?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([occurredAt, id])
  @@index([actorId, occurredAt, id])
  @@index([action, occurredAt, id])
  @@index([targetType, targetId, occurredAt, id])
  @@map("audit_logs")
}

model Backup {
  id          String       @id @default(uuid())
  source      BackupSource
  actorId     String?      @map("actor_id")
  state       BackupState  @default(RUNNING)
  startedAt   DateTime     @default(now()) @map("started_at")
  completedAt DateTime?    @map("completed_at")
  byteCount   BigInt?      @map("byte_count")
  archiveHash String?      @map("archive_hash")
  archiveId   String?      @unique @map("archive_id")
  failureCode String?      @map("failure_code")
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([state, completedAt, id])
  @@map("backups")
}
